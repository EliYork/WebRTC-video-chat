PORT=3000
USE_HTTPS=false
ENV="dev" # production, or any other value for development

# Screen sharing defaults to P2P-first; legacy auto and manual SFU remain available.
# Requires Node >= 22. Example budget for a 20 Mbps public egress.
# Set your public IP (or resolvable public hostname) and open UDP + TCP 44444.
# Leave the address blank to keep P2P; HTTPS reverse proxy does not relay RTP.
SFU_ENABLED=true
SFU_ANNOUNCED_ADDRESS=
SFU_LISTEN_IP=0.0.0.0
SFU_PORT=44444
# A high ceiling, NOT a fixed rate. Initial reservation yields to measured demand.
# Sustained actual egress pressure returns viewers to P2P with hysteresis.
SFU_EGRESS_MBPS=20
SFU_RESERVED_MBPS=4
SFU_VIDEO_MBPS=15
SFU_PAYLOAD_MBPS=16
SFU_INITIAL_VIEWER_MBPS=3.5
SFU_MEMORY_LIMIT_MB=700
SFU_CPU_LIMIT_PERCENT=85
