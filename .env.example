PORT=3000
USE_HTTPS=false
# Direct Node HTTPS only: configure both paths or leave both blank to use
# cert/selfsigned.key + cert/selfsigned.crt. Relative paths use the project root.
# Invalid or unreadable TLS files stop startup; HTTPS never falls back to HTTP.
TLS_KEY_FILE=
TLS_CERT_FILE=
ENV="dev" # production, or any other value for development

# Optional authenticated coturn REST credentials. Configure BOTH, or leave both blank.
# Never put the shared secret in HTML, browser settings, Git or the release ZIP.
# Examples: turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp
TURN_URLS=
TURN_SHARED_SECRET=
# 600–86400 seconds. Default 1 hour; new-connection credentials refresh in the browser.
TURN_TTL_SECONDS=3600

# Screen sharing defaults to P2P-first; legacy auto and manual SFU remain available.
# Requires Node >= 22. Example budget for a 20 Mbps public egress.
# Set your public IP (or resolvable public hostname) and open UDP + TCP 44444.
# Leave the address blank to keep P2P; HTTPS reverse proxy does not relay RTP.
SFU_ENABLED=true
SFU_ANNOUNCED_ADDRESS=
SFU_LISTEN_IP=0.0.0.0
SFU_PORT=44444
# A high ceiling, NOT a fixed rate. Initial reservation yields to measured demand.
# Sustained actual egress pressure returns viewers to P2P with hysteresis.
SFU_EGRESS_MBPS=20
SFU_RESERVED_MBPS=4
SFU_VIDEO_MBPS=15
SFU_PAYLOAD_MBPS=16
SFU_INITIAL_VIEWER_MBPS=3.5
SFU_MEMORY_LIMIT_MB=700
SFU_CPU_LIMIT_PERCENT=85
