<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>语音据点</title>
    <meta name="theme-color" content="#D97799">
    <link rel="icon" href="/favicon.ico?v=brand-20261022" sizes="16x16 32x32 48x48 256x256">
    <link rel="icon" href="/assets/brand/voice.svg?v=brand-20261022" type="image/svg+xml" sizes="any">
    <link rel="apple-touch-icon" href="/assets/brand/apple-touch-icon.png?v=brand-20261022">
    <link rel="stylesheet" href="/style.css?v=25562">
    <script src="https://kit.fontawesome.com/279db593be.js" crossorigin="anonymous"></script>
</head>
<body>
    <div id="main">
        <main class="channel-page">
            <section class="channel-header">
                <h1>语音据点</h1>
                <p>选择一个固定频道进入语音房间。</p>
                <% if (invalidChannel) { %>
                    <p class="channel-warning">频道不存在，请从下面选择一个可用频道。</p>
                <% } %>
            </section>

            <section class="channel-list" aria-label="频道列表">
                <% channels.forEach((channel) => { %>
                    <article class="channel-card">
                        <div>
                            <h2><%= channel.name %></h2>
                            <p><%= channel.description %></p>
                        </div>
                        <a class="channel-enter" href="/room/<%= channel.slug %>">进入</a>
                    </article>
                <% }) %>
            </section>
        </main>
    </div>
</body>
</html>
