<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= channelName %> - 语音据点</title>
    <link rel="stylesheet" href="/style.css?v=25564">
    
    <script src="/socket.io/socket.io.js"></script>
    
    <!-- @todo - see to import peerjs, and fontawesome fron nodemodules, not cdn -->
    <script src="https://unpkg.com/peerjs@1.5.4/dist/peerjs.min.js"></script>
    <script src="https://kit.fontawesome.com/279db593be.js" crossorigin="anonymous"></script>
    <script>
        const ROOM_ID = '<%= roomId %>'
        const iceServers = JSON.parse('<%- iceServers %>')
    </script>
</head>
<body>
    <div id="main" class="room-layout">
        <aside class="room-sidebar" aria-label="频道列表">
            <div class="sidebar-brand">
                <a href="/">朋友语音房间</a>
                <p>今晚在哪个频道集合？</p>
            </div>

            <nav class="sidebar-channel-tree">
                <% channels.forEach((channel) => { %>
                    <div
                        class="tree-channel voice-channel <%= channel.slug === roomId ? 'is-viewing' : '' %>"
                        data-channel-room="<%= channel.slug %>"
                        data-channel-name="<%= channel.name %>"
                        data-channel-description="<%= channel.description %>"
                    >
                        <a class="tree-channel-link" href="/room/<%= channel.slug %>">
                            <span class="tree-channel-name">
                                <span class="tree-channel-icon">🔊</span>
                                <%= channel.name %>
                            </span>
                            <span
                                class="tree-channel-count"
                                data-channel-count="<%= channel.slug %>"
                            >0</span>
                        </a>
                        <ul
                            class="channel-members"
                            data-members-for="<%= channel.slug %>"
                            aria-label="<%= channel.name %> 成员"
                        ></ul>
                    </div>
                <% }) %>
            </nav>

            <section class="local-user-card" aria-label="本地用户控制">
                <div id="buttons" class="hidden media-dock" aria-label="通话控制">
                    <div class="media-dock-header">
                        <div class="local-user-header media-dock-user">
                            <div class="local-avatar" aria-hidden="true">♡</div>
                            <div class="local-user-identity">
                                <strong id="localUserName">Guest</strong>
                                <p id="callStatusText">未加入语音</p>
                            </div>
                        </div>
                        <div class="media-dock-info">
                            <span class="media-dock-kicker">语音详情</span>
                            <strong id="localVoiceChannelName">大厅</strong>
                            <span class="media-dock-timer">
                                <i class="fas fa-signal" aria-hidden="true"></i>
                                <span id="callDuration">00:00</span>
                            </span>
                        </div>
                    </div>
                    <div class="media-dock-activity-row">
                        <span id="screenStatusText" class="media-dock-pill screen-status-chip hidden">
                            <i class="fas fa-desktop" aria-hidden="true"></i>
                            共享中
                        </span>
                        <span id="noiseToggle" class="media-dock-pill noise-toggle" role="button" tabindex="0" aria-pressed="true">
                            <i class="fas fa-wind" aria-hidden="true"></i>
                            降噪 <strong id="noiseStatusText">开</strong>
                        </span>
                        <span id="aiNoiseToggle" class="media-dock-pill noise-toggle" role="button" tabindex="0" aria-pressed="false" data-not-supported-label="N/A">
                            <i class="fas fa-magic" aria-hidden="true"></i>
                            AI <strong id="aiNoiseStatusText">关</strong>
                        </span>
                        <button id="destroyPeer" class="hidden media-dock-hangup" type="button" title="离开当前语音频道" aria-label="离开当前语音频道">
                            <i class="fas fa-phone-slash" aria-hidden="true"></i>
                        </button>
                    </div>
                    <div class="media-dock-actions" aria-label="语音控制按钮">
                        <button id="copyRoomLink" class="media-dock-action-button copy-room-link" type="button" title="复制频道链接" aria-label="复制频道链接">
                            <i class="fas fa-link" aria-hidden="true"></i>
                            <span>链接</span>
                        </button>
                        <button id="shareScreen" class="media-dock-action-button" type="button" title="屏幕共享" aria-label="屏幕共享" aria-pressed="false">
                            <i class="far fa-newspaper"></i>
                            <span>共享</span>
                        </button>
                        <button id="toggleVideo" class="media-dock-action-button" type="button" title="摄像头" aria-label="摄像头" aria-pressed="false">
                            <i class="fas fa-video"></i>
                            <span>视频</span>
                        </button>
                        <div class="media-dock-control-group control-button-wrap" data-device-control="mic">
                            <button id="toggleAudio" type="button" title="麦克风" aria-label="麦克风" aria-pressed="false">
                                <i class="fas fa-microphone"></i>
                            </button>
                            <button class="control-menu-toggle" type="button" aria-label="麦克风设置" aria-expanded="false" data-control-menu="mic">
                                <i class="fas fa-chevron-up"></i>
                            </button>
                        </div>
                        <div class="media-dock-control-group control-button-wrap" data-device-control="output">
                            <button id="toggleOutput" type="button" title="听筒" aria-label="听筒" aria-pressed="false">
                                <i class="fas fa-volume-up"></i>
                            </button>
                            <button class="control-menu-toggle" type="button" aria-label="播放设置" aria-expanded="false" data-control-menu="output">
                                <i class="fas fa-chevron-up"></i>
                            </button>
                        </div>
                    </div>
                    <section class="media-device-popover mic-volume-popover" data-control-panel="mic" data-device-popover="mic" role="dialog" aria-label="麦克风设备">
                        <div class="media-device-popover-header">
                            <strong>麦克风</strong>
                            <span id="micDeviceStatus">默认设备</span>
                        </div>
                        <div class="media-device-list" data-device-list="mic"></div>
                        <label class="media-volume-row">
                            <span>输入音量</span>
                            <input id="micGainSlider" type="range" min="0" max="150" step="5" value="100">
                            <strong id="micGainValue">100%</strong>
                        </label>
                    </section>
                    <section class="media-device-popover" data-control-panel="output" data-device-popover="output" role="dialog" aria-label="输出设备">
                        <div class="media-device-popover-header">
                            <strong>耳机</strong>
                            <span id="outputDeviceStatus">默认设备</span>
                        </div>
                        <p class="media-device-warning hidden" data-output-unsupported>当前浏览器不支持选择输出设备</p>
                        <div class="media-device-list" data-device-list="output"></div>
                        <label class="media-volume-row">
                            <span>输出音量</span>
                            <input id="outputVolume" type="range" min="0" max="1" step="0.05" value="1">
                            <strong id="outputVolumeValue">100%</strong>
                        </label>
                    </section>
                </div>
            </section>
        </aside>

        <main class="room-stage" aria-label="活动区">
            <button id="mobileBackToChannels" class="mobile-back-button" type="button">返回</button>
            <div class="mobile-tile-nav" aria-label="玩家窗口切换">
                <button id="mobilePrevTile" type="button" aria-label="上一个窗口">‹</button>
                <span id="mobileTileCount">0 / 0</span>
                <button id="mobileNextTile" type="button" aria-label="下一个窗口">›</button>
            </div>
            <section id="canvas" class="stage-canvas" aria-label="玩家窗口区">
                <div id="video-grid"></div>
            </section>
        </main>

        <aside id="chat-panel" class="chat-panel" aria-label="频道聊天">
            <input id="chatName" type="hidden" maxlength="32" autocomplete="nickname">
            <ol id="chatMessages" class="chat-messages"></ol>
            <form id="chatForm" class="chat-form">
                <textarea id="chatInput" maxlength="500" rows="2" placeholder="发送消息"></textarea>
                <button type="submit">发送</button>
            </form>
        </aside>
    </div> 
    <script src="/js/shared/view-utils.js"></script>
    <script src="/js/chat/chat-name-state.js"></script>
    <script src="/js/media/noise-settings-ui.js"></script>
    <script src="/js/shared/control-popovers-ui.js"></script>
    <script src="/js/media/peer-volume-ui.js"></script>
    <script src="/js/shared/copy-link-ui.js"></script>
    <script src="/js/media/output-volume-state.js"></script>
    <script src="/js/media/output-volume-ui.js"></script>
    <script src="/js/media/media-controls-ui.js"></script>
    <script src="/js/media/fullscreen-controls.js"></script>
    <script src="/js/media/voice-join-overlay-ui.js"></script>
    <script src="/js/layout/page-layout-snap-utils.js"></script>
    <script src="/js/layout/page-layout-resize-utils.js"></script>
    <script src="/js/layout/page-layout-edit-ui.js"></script>
    <script src="/js/layout/page-layout-component-actions-ui.js"></script>
    <script src="/js/layout/page-layout-storage.js"></script>
    <script src="/js/layout/page-layout-config.js"></script>
    <script src="/js/layout/page-layout-ids.js"></script>
    <script src="/js/layout/page-layout-placement-utils.js"></script>
    <script src="/js/layout/page-layout-components.js"></script>
    <script src="/js/layout/page-layout-toolbar-ui.js"></script>
    <script src="/js/layout/page-layout-component-menu-ui.js"></script>
    <script src="/js/layout/page-layout-recovery-ui.js"></script>
    <script src="/js/layout/page-layout-runtime.js"></script>
    <script src="/js/layout/page-layout-editor-runtime.js"></script>
    <script src="/js/layout/page-layout-component-runtime.js"></script>
    <script src="/js/layout/page-layout-store-runtime.js"></script>
    <script src="/js/room/room-ui-state.js"></script>
    <script src="/js/room/mobile-room-state.js"></script>
    <script src="/js/room/presence-view-model.js"></script>
    <script src="/js/room/participants-list-ui.js"></script>
    <script src="/js/room/tile-status-ui.js"></script>
    <script src="/js/room/video-tile-structure-ui.js"></script>
    <script src="/js/chat/chat-message-ui.js"></script>
    <script src="/js/chat/chat-form-ui.js"></script>
    <script src="/js/room/channel-sidebar-ui.js"></script>
    <script src="/js/room/cursor-share-ui.js"></script>
    <script src="/js/voice/voice-call-protocol.js"></script>
    <script src="/js/voice/voice-peer-registry.js"></script>
    <script src="/js/voice/voice-media-lifecycle.js"></script>
    <script type="module" src="/script.js"></script> <!-- So we defined the static files of the server so we can use it here-->
</body>
</html>
