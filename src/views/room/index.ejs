<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= channelName %> - 语音据点</title>
    <link rel="stylesheet" href="/style.css?v=25556">
    
    <script src="/socket.io/socket.io.js"></script>
    
    <!-- @todo - see to import peerjs, and fontawesome fron nodemodules, not cdn -->
    <script src="https://unpkg.com/peerjs@1.5.4/dist/peerjs.min.js"></script>
    <script src="https://kit.fontawesome.com/279db593be.js" crossorigin="anonymous"></script>
    <script>
        const ROOM_ID = '<%= roomId %>'
        const PEER_PORT = '<%= peerPort %>'
        const iceServers = JSON.parse('<%- iceServers %>')
    </script>
</head>
<body>
    <div id="main">
        <div class="room-header">
            <a href="/">频道列表</a>
            <div>当前频道：<%= channelName %></div>
            <button id="copyRoomLink" type="button">复制频道链接</button>
        </div>
        <div id="canvas">
            <div id="video-grid"></div>
            <div id="join-btn" class="text-center">
                <button>Join Call</button>
            </div>
        </div>
        <section id="chat-panel" class="chat-panel" aria-label="频道聊天">
            <div class="chat-header">
                <div>
                    <h2>当前频道聊天</h2>
                    <p>消息仅在当前频道内广播。</p>
                </div>
                <label>
                    昵称
                    <input id="chatName" maxlength="32" autocomplete="nickname">
                </label>
            </div>
            <ol id="chatMessages" class="chat-messages"></ol>
            <form id="chatForm" class="chat-form">
                <textarea id="chatInput" maxlength="500" rows="2" placeholder="输入消息，Enter 发送，Shift+Enter 换行"></textarea>
                <button type="submit">发送</button>
            </form>
        </section>
        <div id="buttons" class="hidden">
            <div id="toggleAudio"><i class="fas fa-microphone"></i></div>
            <div id="videoOptions">
                <div id="toggleVideo"><i class="fas fa-video"></i></div>
                <div id="shareScreen"><i class="far fa-newspaper red"></i></div>
            </div>
            <div id="destroyPeer">Exit call</div>
        </div> 
    </div> 
    <script type="module" src="/script.js"></script> <!-- So we defined the static files of the server so we can use it here-->
</body>
</html>
