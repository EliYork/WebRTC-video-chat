<!DOCTYPE html>
<% const piikPrototype = typeof piikEnabled !== 'undefined' && piikEnabled; %>
<html lang="zh-CN" data-room-boot="pending">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title><%= channelName %> - 语音据点</title>
    <meta name="theme-color" content="#D97799">
    <link rel="icon" href="/favicon.ico?v=brand-20261022" sizes="16x16 32x32 48x48 256x256">
    <link rel="icon" href="/assets/brand/voice.svg?v=brand-20261022" type="image/svg+xml" sizes="any">
    <link rel="apple-touch-icon" href="/assets/brand/apple-touch-icon.png?v=brand-20261022">
    <style>
        body { background: #fbf7f9; }
        .room-boot-status { display: none; }
        html[data-room-boot='fallback'] .room-boot-status { display: flex; position: fixed; top: 58px; left: 50%; transform: translateX(-50%); z-index: 30000; gap: 12px; padding: 12px 16px; border-radius: 10px; background: #fff; color: #887681; box-shadow: 0 4px 24px #44364118; }
        .room-boot-status button { display: none; }
        html[data-room-boot='fallback'] .room-boot-status button { display: block; }
    </style>
    <noscript><style>.room-boot-status { display: none !important; }</style></noscript>
    <script src="/js/shared/room-boot.js"></script>
    <link rel="stylesheet" href="/style.css?v=stage-voice-20261018">
    <link rel="stylesheet" href="/vendor/fontawesome/css/fontawesome.min.css">
    <link rel="stylesheet" href="/vendor/fontawesome/css/solid.min.css">
    <link rel="stylesheet" href="/vendor/fontawesome/css/regular.min.css">
    
    <script src="/socket.io/socket.io.js"></script>
    
    <script src="/vendor/peerjs/peerjs.min.js" defer></script>
    <script nonce="<%= cspNonce %>">
        const roomBootstrap = <%- roomBootstrap %>
        const ROOM_ID = roomBootstrap.roomId
        const iceServers = roomBootstrap.iceServers
        window.voiceBuildInfo = roomBootstrap.buildInfo || {}
        window.voiceScreenSfuConfig = roomBootstrap.screenSfu || {}
        window.voiceScreenMediaProvider = roomBootstrap.screenMediaProvider || 'legacy'
    </script>
</head>
<body>
    <div class="room-boot-status" role="status"><span data-room-load-message></span><button type="button" data-room-reload>刷新重试</button></div>
    <header class="workspace-topbar" aria-label="语音据点">
        <div class="workspace-brand">
            <img class="workspace-mark" src="/assets/brand/voice.svg?v=brand-20261022" width="30" height="30" alt="" aria-hidden="true">
            <strong>语音据点</strong>
        </div>
        <div class="workspace-actions">
            <nav class="workspace-navigation" aria-label="切换频道、舞台和聊天">
            <button type="button" id="stageChannelsToggle" aria-controls="stage-channels" aria-expanded="false">频道</button>
            <button type="button" id="stageStageToggle" aria-controls="member-cards canvas" aria-pressed="true">语音</button>
            <button type="button" id="stageChatToggle" aria-controls="chat-panel" aria-expanded="true">聊天</button>
            </nav>
            <button type="button" id="stageMoreToggle" aria-controls="workspace-tools" aria-expanded="false" aria-label="更多操作">•••</button>
            <div class="workspace-tools" id="workspace-tools" role="group" aria-label="更多操作" inert>
            <button type="button" class="workspace-copy-diagnostics" data-copy-call-diagnostics aria-live="polite" aria-atomic="true">复制诊断</button>
            <a class="workspace-download" href="/download/windows" target="_blank" rel="noopener" title="下载 Windows 客户端（Windows 10/11，64 位）" aria-label="下载 Windows 客户端（64 位）"><i class="fa-solid fa-download" aria-hidden="true"></i><span>下载客户端</span></a>
            </div>
        </div>
        <p id="stageConnectionStatus" class="stage-connection-status" role="status" hidden></p>
    </header>
    <div id="main" class="room-layout stage-layout" data-stage-mode="voice">
        <div class="stage-sidebar-column">
        <aside id="stage-channels" class="room-sidebar" aria-label="频道列表">
            <h2 class="channel-section-title">语音频道</h2>
            <nav id="channel-sidebar" class="sidebar-channel-tree">
                <% channels.forEach((channel) => { %>
                    <div
                        class="tree-channel voice-channel <%= channel.slug === roomId ? 'is-viewing' : '' %>"
                        data-channel-room="<%= channel.slug %>"
                        data-channel-name="<%= channel.name %>"
                        data-channel-description="<%= channel.description %>"
                    >
                        <a class="tree-channel-link" href="/room/<%= channel.slug %>">
                            <span class="tree-channel-name">
                                <span class="tree-channel-icon" aria-hidden="true">#</span>
                                <%= channel.name %>
                            </span>
                            <span
                                class="tree-channel-count"
                                data-channel-count="<%= channel.slug %>"
                            >0</span>
                        </a>
                        <ul
                            class="channel-members"
                            data-members-for="<%= channel.slug %>"
                            aria-label="<%= channel.name %> 成员"
                        ></ul>
                    </div>
                <% }) %>
            </nav>
        </aside>
        <footer class="stage-dock">
            <section class="local-user-card" aria-label="本地用户控制">
                <div id="buttons" class="hidden media-dock" aria-label="通话控制">
                    <div class="media-dock-header">
                        <div class="local-user-header media-dock-user">
                            <div class="local-avatar" aria-hidden="true">♡</div>
                            <div class="local-user-identity">
                                <strong id="localUserName">Guest</strong>
                                <p id="callStatusText">未加入语音</p>
                            </div>
                        </div>
                        <div class="media-dock-info">
                            <span class="media-dock-kicker">语音详情</span>
                            <strong id="localVoiceChannelName">大厅</strong>
                            <span class="media-dock-timer">
                                <i class="fas fa-signal" aria-hidden="true"></i>
                                <span id="callDuration">00:00</span>
                            </span>
                        </div>
                    </div>
                    <div class="media-dock-activity-row">
                        <span id="screenStatusText" class="media-dock-pill screen-status-chip hidden">
                            <i class="fas fa-desktop" aria-hidden="true"></i>
                            共享中
                        </span>
                        <button id="copyRoomLink" class="media-dock-action-button copy-room-link" type="button" title="复制频道链接" aria-label="复制频道链接"><i class="fas fa-link" aria-hidden="true"></i><span>复制链接</span></button>
                        <button id="destroyPeer" class="media-dock-hangup" type="button" title="加入当前语音频道" aria-label="加入当前语音频道" data-session-action="join">
                            <i class="fas fa-phone-slash" aria-hidden="true"></i>
                            <span data-session-label>加入语音</span>
                        </button>
                    </div>
                    <div id="voiceStatusMessages" class="voice-status-messages hidden" role="status" aria-live="polite" aria-atomic="false"></div>
                    <div class="media-dock-actions" aria-label="语音控制按钮">
                        <div class="media-dock-control-group control-button-wrap" data-device-control="screen">
                            <button id="shareScreen" class="media-dock-action-button" type="button" title="开始屏幕共享" aria-label="开始屏幕共享" aria-pressed="false">
                                <i class="far fa-newspaper"></i>
                                <span>共享</span>
                            </button>
                            <button class="control-menu-toggle" type="button" aria-label="屏幕共享设置" aria-expanded="false" data-control-menu="screen">
                                <i class="fas fa-chevron-up"></i>
                            </button>
                        </div>
                        <div class="media-dock-control-group control-button-wrap" data-device-control="camera">
                            <button id="toggleVideo" class="media-dock-action-button" type="button" title="摄像头" aria-label="摄像头" aria-pressed="false">
                                <i class="fas fa-video"></i>
                                <span>摄像头</span>
                            </button>
                            <button class="control-menu-toggle" type="button" aria-label="摄像头设置" aria-expanded="false" data-control-menu="camera">
                                <i class="fas fa-chevron-up"></i>
                            </button>
                        </div>
                        <div class="media-dock-control-group control-button-wrap" data-device-control="mic">
                            <button id="toggleAudio" class="media-dock-action-button" type="button" title="麦克风" aria-label="麦克风" aria-pressed="false">
                                <i class="fas fa-microphone"></i>
                                <span>麦克风</span>
                            </button>
                            <button class="control-menu-toggle" type="button" aria-label="麦克风设置" aria-expanded="false" data-control-menu="mic">
                                <i class="fas fa-chevron-up"></i>
                            </button>
                        </div>
                        <div class="media-dock-control-group control-button-wrap" data-device-control="output">
                            <button id="toggleOutput" class="media-dock-action-button" type="button" title="听筒" aria-label="听筒" aria-pressed="false">
                                <i class="fas fa-volume-up"></i>
                                <span>播放音量</span>
                            </button>
                            <button class="control-menu-toggle" type="button" aria-label="播放设置" aria-expanded="false" data-control-menu="output">
                                <i class="fas fa-chevron-up"></i>
                            </button>
                        </div>
                    </div>
                    <section class="media-device-popover mic-volume-popover" data-control-panel="mic" data-device-popover="mic" popover="manual" role="dialog" aria-label="麦克风设备">
                        <div class="media-device-popover-header">
                            <strong>麦克风</strong>
                            <span id="micDeviceStatus">默认设备</span>
                            <button type="button" data-control-close aria-label="关闭麦克风设置">完成</button>
                        </div>
                        <div class="media-device-list" data-device-list="mic"></div>
                        <label class="media-volume-row">
                            <span>输入音量</span>
                            <input id="micGainSlider" type="range" min="0" max="150" step="5" value="100">
                            <strong id="micGainValue">100%</strong>
                        </label>
                        <div class="media-audio-options">
                            <span id="noiseToggle" class="media-dock-pill noise-toggle" role="button" tabindex="0" aria-pressed="true">浏览器降噪 <strong id="noiseStatusText">开</strong></span>
                            <span id="aiNoiseToggle" class="media-dock-pill noise-toggle" role="button" tabindex="0" aria-pressed="false" data-not-supported-label="N/A">RNNoise <strong id="aiNoiseStatusText">关</strong></span>
                        </div>
                        <label class="media-device-status">降噪模式
                            <select data-audio-noise-mode aria-label="降噪模式">
                                <option value="off">关闭</option>
                                <option value="browser">浏览器内置</option>
                                <option value="rnnoise">RNNoise</option>
                                <option value="deepfilter">增强降噪 · DeepFilterNet3（实验）</option>
                            </select>
                        </label>
                        <label class="media-device-status" title="只作用于 RNNoise；压低非语音残留。轻声或首字变弱时可关闭对比。">
                            <input type="checkbox" data-rnnoise-speech-gate checked>
                            非语音门控（RNNoise）
                        </label>
                        <p class="media-device-status">增强降噪在本机处理，首次加载约 23 MB；会增加语音延迟，轻声或首字变弱时可切回 RNNoise 对比。</p>
                        <p class="media-device-status" data-audio-processing-status role="status" aria-live="polite"></p>
                        <details>
                            <summary>通话诊断与日志</summary>
                            <p class="media-device-status">非语音门控主要压低不讲话时的残留；讲话时的键盘声仍由 RNNoise 处理。本机保留最近 5 次日志，不录音。</p>
                            <div class="media-audio-options">
                                <button type="button" data-show-call-logs>查看最近通话日志</button>
                                <button type="button" data-clear-call-logs>清除历史日志</button>
                            </div>
                        </details>
                    </section>
                    <section class="media-device-popover" data-control-panel="camera" data-device-popover="camera" popover="manual" role="dialog" aria-label="摄像头设备">
                        <div class="media-device-popover-header">
                            <strong>摄像头</strong>
                            <span id="cameraDeviceStatus">默认设备</span>
                            <button type="button" data-control-close aria-label="关闭摄像头设置">完成</button>
                        </div>
                        <div class="media-device-list" data-device-list="camera"></div>
                    </section>
                    <section class="media-device-popover" data-control-panel="output" data-device-popover="output" popover="manual" role="dialog" aria-label="输出设备">
                        <div class="media-device-popover-header">
                            <strong>耳机</strong>
                            <span id="outputDeviceStatus">默认设备</span>
                            <button type="button" data-control-close aria-label="关闭播放设置">完成</button>
                        </div>
                        <p class="media-device-warning hidden" data-output-unsupported>当前浏览器不支持选择输出设备</p>
                        <div class="media-device-list" data-device-list="output"></div>
                        <label class="media-volume-row">
                            <span>输出音量</span>
                            <input id="outputVolume" type="range" min="0" max="1" step="0.05" value="1">
                            <strong id="outputVolumeValue">100%</strong>
                        </label>
                        <label class="voice-event-sound-toggle"><input id="voiceEventSounds" type="checkbox" checked><span>成员加入 / 离开提示音</span></label>
                        <label class="media-volume-row">
                            <span>提示音量</span>
                            <input id="voiceEventVolume" type="range" min="0" max="1" step="0.05" value="0.35">
                            <strong id="voiceEventVolumeValue">35%</strong>
                        </label>
                        <p class="voice-event-sound-hint">加入 do–re，离开 re–do。跟随总静音和当前输出设备。</p>
                        <p id="voiceEventSoundStatus" class="voice-event-sound-hint" role="status"></p>
                    </section>
                    <%- include('share-dialog', { piikPrototype }) %>
                </div>
            </section>
        </footer>
        </div>
        <main class="room-stage" aria-label="屏幕共享舞台">
            <header class="share-stage-header"><strong>正在观看</strong><nav id="share-sources" aria-label="选择共享源"></nav>
                <div class="local-share-controls" data-local-share-controls hidden><span data-local-share-state>正在共享</span><button type="button" data-share-action="source">更换画面</button><button type="button" data-share-action="quality">画质</button><button type="button" data-share-action="stop">停止共享</button></div>
            </header>
            <section id="canvas" class="stage-canvas" aria-label="共享画面"><div id="video-grid"></div></section>
        </main>
        <section class="stage-members" aria-label="语音成员舞台">
            <p id="stageShareNotice" class="stage-share-notice" role="status" hidden></p>
            <header class="members-heading"><div><strong id="stageChannelName"><%= channelName %></strong><span id="stageChannelStatus">语音成员舞台</span></div><span id="member-count">0 人</span></header>
            <div id="members-empty" class="members-empty" role="status">
                <div class="stage-welcome-mark" aria-hidden="true">◖◗</div>
                <h1 id="stageWelcomeTitle">加入语音，一起待一会儿</h1>
                <p id="stageWelcomeDetail">加入后，成员头像与摄像头会显示在中央；共享屏幕时自动切换到观看舞台。</p>
                <button id="stageJoinVoice" type="button">加入语音</button>
            </div>
            <div id="member-cards" role="list" aria-label="成员卡片"></div>
        </section>

        <aside id="chat-panel" class="chat-panel" aria-label="频道聊天">
            <header class="stage-chat-heading"><h2 id="chatTitle">频道聊天</h2><p id="chatDescription" hidden></p><button id="chatJumpToLatest" type="button" hidden>查看新消息</button></header>
            <input id="chatName" type="hidden" maxlength="32" autocomplete="nickname">
            <ol id="chatMessages" class="chat-messages"></ol>
            <form id="chatForm" class="chat-form">
                <textarea id="chatInput" maxlength="500" rows="2" placeholder="发送消息"></textarea>
                <button type="submit">发送</button>
            </form>
        </aside>

    </div> 
    <script src="/js/shared/view-utils.js"></script>
    <script src="/js/chat/chat-name-state.js"></script>
    <script src="/js/media/noise-settings-ui.js"></script>
    <script src="/js/media/audio-processing-view.js"></script>
    <script src="/js/shared/control-popovers-ui.js"></script>
    <script src="/js/media/peer-volume-ui.js"></script>
    <script src="/js/shared/copy-link-ui.js"></script>
    <script src="/js/media/output-volume-state.js"></script>
    <script src="/js/media/remote-audio-gain.js"></script>
    <script src="/js/media/output-volume-ui.js"></script>
    <script src="/js/media/media-controls-ui.js"></script>
    <script src="/js/media/media-dock-adapter.js"></script>
    <script src="/js/media/media-dock-runtime.js"></script>
    <script src="/js/media/screen-share-volume-controller.js"></script>
    <script src="/js/media/fullscreen-controls.js"></script>
    <script src="/js/media/local-screen-share-preview-controller.js"></script>
    <script src="/js/media/voice-join-overlay-ui.js"></script>
    <script src="/js/room/room-ui-state.js"></script>
    <script src="/js/room/presence-view-model.js"></script>
    <script src="/js/room/participants-list-ui.js"></script>
    <script src="/js/room/tile-status-ui.js"></script>
    <script src="/js/room/video-tile-structure-ui.js"></script>
    <script src="/js/chat/chat-message-ui.js"></script>
    <script src="/js/chat/chat-form-ui.js"></script>
    <script src="/js/chat/chat-socket-transport.js"></script>
    <script src="/js/chat/chat-panel-runtime.js"></script>
    <script src="/js/room/channel-sidebar-ui.js"></script>
    <script src="/js/sidebar/sidebar-socket-transport.js"></script>
    <script src="/js/sidebar/sidebar-runtime.js"></script>
    <script src="/js/room/cursor-share-ui.js"></script>
    <script src="/js/voice/voice-call-protocol.js"></script>
    <script src="/js/voice/voice-screen-codecs.js"></script>
    <script src="/js/voice/voice-screen-send-policy.js"></script>
    <script src="/vendor/screen-sfu-client.js"></script>
    <script src="/js/voice/voice-screen-sfu-runtime.js"></script>
    <% if (typeof piikEnabled !== 'undefined' && piikEnabled) { %><script src="/vendor/piik-client.js"></script><% } %>
    <script src="/js/voice/voice-peer-registry.js"></script>
    <script src="/js/voice/voice-media-lifecycle.js"></script>
    <script src="/js/voice/voice-retry-controller.js"></script>
    <script src="/js/voice/voice-session-runtime.js"></script>
    <script src="/js/voice/voice-ice-config.js"></script>
    <script src="/js/voice/voice-media-operation-runtime.js"></script>
    <script src="/js/voice/voice-device-runtime.js"></script>
    <script src="/js/voice/voice-audio-recovery.js"></script>
    <script src="/js/voice/voice-audio-processing.js"></script>
    <script src="/js/voice/voice-audio-settings-controller.js"></script>
    <script src="/js/voice/voice-channel-sounds.js"></script>
    <script src="/js/voice/voice-status-view.js"></script>
    <script src="/js/voice/voice-media-quality-view.js"></script>
    <script src="/js/voice/voice-share-stats-view.js"></script>
    <script src="/js/voice/voice-player-menu.js"></script>
    <script src="/js/voice/voice-share-diagnostics.js"></script>
    <script src="/js/voice/voice-player-events.js"></script>
    <script src="/js/voice/voice-call-diagnostics.js"></script>
    <script src="/js/voice/voice-media-quality-runtime.js"></script>
    <script src="/js/room/stage-layout-runtime.js"></script>
    <script src="/js/voice/voice-speaking-runtime.js"></script>
    <script src="/js/voice/share-watch-status.js"></script>
    <script type="module" src="/script.js"></script> <!-- So we defined the static files of the server so we can use it here-->
</body>
</html>
