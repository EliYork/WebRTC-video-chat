<!DOCTYPE html>
<% const piikPrototype = typeof piikEnabled !== 'undefined' && piikEnabled; %>
<html lang="zh-CN" data-room-boot="pending">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title><%= channelName %> - 晓语音</title>
    <meta name="theme-color" content="#D97799">
    <link rel="icon" href="/favicon.ico?v=brand-20261022" sizes="16x16 32x32 48x48 256x256">
    <link rel="icon" href="/assets/brand/voice.svg?v=brand-20261022" type="image/svg+xml" sizes="any">
    <link rel="apple-touch-icon" href="/assets/brand/apple-touch-icon.png?v=brand-20261022">
    <style>
        body { background: #fbf7f9; }
        .room-boot-status { display: none; }
        html[data-room-boot]:not([data-room-boot='ready']):not([data-room-boot='pending']) .room-boot-status { display: flex; }
        .room-boot-status { box-sizing: border-box; position: fixed; top: calc(var(--workspace-bar-height, 56px) + env(safe-area-inset-top) + 8px); left: 50%; transform: translateX(-50%); z-index: 30000; align-items: center; gap: 12px; width: max-content; max-width: calc(100vw - 24px); margin: 0; padding: 10px 14px; border: 1px solid #eadfe5; border-radius: 12px; background: #fff; color: #887681; box-shadow: 0 4px 16px #44364110; font: 13px/1.6 -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; }
        .room-boot-status span { min-width: 0; overflow-wrap: anywhere; }
        .room-boot-status button { display: none; flex: 0 0 auto; min-height: 40px; padding: 6px 10px; border: 1px solid #eadfe5; border-radius: 8px; background: #fbf7f9; color: #6b4d5c; font: inherit; white-space: nowrap; }
        html[data-room-boot='fallback'] .room-boot-status button, html[data-room-boot='stalled'] .room-boot-status button { display: block; }
        html[data-room-boot]:not([data-room-boot='ready']):not([data-room-boot='pending']) #main.stage-layout { padding-top: calc(var(--workspace-bar-height, 56px) + env(safe-area-inset-top) + 52px); }
    </style>
    <noscript><style>.room-boot-status { display: none !important; }</style></noscript>
    <script nonce="<%= cspNonce %>"><%- include('../js/shared/room-boot.js') %></script>
    <script nonce="<%= cspNonce %>">
        const roomBootstrap = <%- roomBootstrap %>
        const ROOM_ID = roomBootstrap.roomId
        const iceServers = roomBootstrap.iceServers
        window.voiceBuildInfo = roomBootstrap.buildInfo || {}
        window.voiceScreenSfuConfig = roomBootstrap.screenSfu || {}
        window.voiceScreenMediaProvider = roomBootstrap.screenMediaProvider || 'legacy'
    </script>
    <link rel="stylesheet" data-room-startup-style href="/style.css?v=<%= roomAssetVersions.stylesheet %>">
    <link rel="stylesheet" href="/vendor/fontawesome/css/fontawesome.min.css">
    <link rel="stylesheet" href="/vendor/fontawesome/css/solid.min.css">
    <link rel="stylesheet" href="/vendor/fontawesome/css/regular.min.css">
    <script defer src="/socket.io/socket.io.js"></script>
    <script src="/vendor/peerjs/peerjs.min.js" defer></script>
</head>
<body>
    <div class="room-boot-status" role="status" aria-live="polite" aria-atomic="true"><span data-room-load-message></span><button type="button" data-room-reload>重新加载</button></div>
    <header class="workspace-topbar" aria-label="晓语音" aria-busy="true" inert>
        <div class="workspace-brand">
            <img class="workspace-mark" src="/assets/brand/voice.svg?v=brand-20261022" width="30" height="30" alt="" aria-hidden="true">
            <strong>晓语音</strong>
        </div>
        <div class="workspace-actions">
            <nav class="workspace-navigation" aria-label="切换频道、舞台和聊天">
            <button type="button" id="stageChannelsToggle" aria-controls="stage-channels" aria-expanded="false">频道</button>
            <button type="button" id="stageStageToggle" aria-controls="member-cards canvas" aria-pressed="true">语音</button>
            <button type="button" id="stageChatToggle" aria-controls="chat-panel" aria-expanded="true">聊天</button>
            </nav>
            <button type="button" class="workspace-call-tools-toggle" popovertarget="call-tools">通话日志</button>
            <div id="call-tools" class="call-log-actions" data-call-log-actions popover="auto" role="group" aria-label="通话日志">
                <button type="button" data-copy-call-diagnostics aria-live="polite" aria-atomic="true">复制诊断</button>
                <button type="button" data-show-call-logs>查看日志</button>
            </div>
            <a class="workspace-download" href="/download/windows" target="_blank" rel="noopener" title="下载 Windows 客户端（Windows 10/11，64 位）" aria-label="下载 Windows 客户端（64 位）"><i class="fa-solid fa-download" aria-hidden="true"></i><span>下载客户端</span></a>
        </div>
        <p id="stageConnectionStatus" class="stage-connection-status" role="status" hidden></p>
        <p id="callDiagnosticsFeedback" class="stage-connection-status call-diagnostics-feedback" role="status" aria-atomic="true"></p>
    </header>
    <div id="main" class="room-layout stage-layout" data-stage-mode="voice" data-mobile-panel="stage" aria-busy="true" inert>
        <div class="stage-sidebar-column">
        <aside id="stage-channels" class="room-sidebar" aria-label="频道列表">
            <h2 class="channel-section-title">语音频道</h2>
            <nav id="channel-sidebar" class="sidebar-channel-tree">
                <% channels.forEach((channel) => { %>
                    <div
                        class="tree-channel voice-channel <%= channel.slug === roomId ? 'is-viewing' : '' %>"
                        data-channel-room="<%= channel.slug %>"
                        data-channel-name="<%= channel.name %>"
                    >
                        <a class="tree-channel-link" href="/room/<%= channel.slug %>">
                            <span class="tree-channel-name">
                                <span class="tree-channel-icon" aria-hidden="true">#</span>
                                <%= channel.name %>
                            </span>
                            <span
                                class="tree-channel-count"
                                data-channel-count="<%= channel.slug %>"
                            >0</span>
                        </a>
                        <ul
                            class="channel-members"
                            data-members-for="<%= channel.slug %>"
                            aria-label="<%= channel.name %> 成员"
                        ></ul>
                    </div>
                <% }) %>
            </nav>
        </aside>
        <footer class="stage-dock">
            <section class="local-user-card" aria-label="本地用户控制">
                <div id="buttons" class="hidden media-dock" aria-label="通话控制">
                    <div class="media-dock-header">
                        <div class="local-user-header media-dock-user">
                            <div class="local-avatar" aria-hidden="true">♡</div>
                            <input id="localUserName" class="local-user-name" type="text" value="Guest" maxlength="32" autocomplete="nickname" aria-label="昵称" title="点击修改昵称" />
                        </div>
                        <span class="media-dock-timer">
                            <span class="call-signal-slot">
                                <span id="callSignal" class="call-signal" role="img" data-quality="unknown" data-bars="0" aria-label="通话质量尚未测量">
                                    <svg viewBox="0 0 27 24" width="24" height="20" aria-hidden="true"><rect x="1" y="18" width="3" height="5" rx="1"/><rect x="6" y="14" width="3" height="9" rx="1"/><rect x="11" y="10" width="3" height="13" rx="1"/><rect x="16" y="6" width="3" height="17" rx="1"/><rect x="21" y="2" width="3" height="21" rx="1"/><path class="signal-disconnected" d="M3 3 24 23"/></svg>
                                </span>
                                <span id="callSignalDetail" class="call-signal-detail" aria-hidden="true" hidden>
                                    <span hidden>延迟 <b data-call-rtt></b></span>
                                    <span hidden>丢包 <b data-call-loss></b></span>
                                    <span data-call-mic-row hidden>麦克风发送 <b data-call-mic-rate></b></span>
                                </span>
                            </span>
                            <span id="callDuration">00:00</span>
                        </span>
                    </div>
                    <div class="media-dock-activity-row">
                        <span id="screenStatusText" class="media-dock-pill screen-status-chip hidden">
                            <i class="fas fa-desktop" aria-hidden="true"></i>
                            共享中
                        </span>
                        <button id="copyRoomLink" class="media-dock-action-button copy-room-link" type="button" title="复制频道链接" aria-label="复制频道链接"><i class="fas fa-link" aria-hidden="true"></i><span>复制链接</span></button>
                        <button id="destroyPeer" class="media-dock-hangup" type="button" title="加入当前语音频道" aria-label="加入当前语音频道" data-session-action="join">
                            <i class="fas fa-phone-slash" aria-hidden="true"></i>
                            <span data-session-label>加入语音</span>
                        </button>
                    </div>
                    <div id="voiceStatusMessages" class="voice-status-messages hidden" role="status" aria-live="polite" aria-atomic="false"></div>
                    <div class="media-dock-actions" aria-label="语音控制按钮">
                        <div class="media-dock-control-group control-button-wrap" data-device-control="screen">
                            <button id="shareScreen" class="media-dock-action-button" type="button" title="开始屏幕共享" aria-label="开始屏幕共享" aria-pressed="false">
                                <i class="far fa-newspaper"></i>
                                <span>共享</span>
                            </button>
                        </div>
                        <div class="media-dock-control-group control-button-wrap" data-device-control="camera">
                            <button id="toggleVideo" aria-haspopup="dialog" aria-expanded="false" aria-controls="camera-device-panel" aria-keyshortcuts="Shift+F10" class="media-dock-action-button" type="button" title="摄像头" aria-label="摄像头" aria-pressed="false">
                                <i class="fas fa-video"></i>
                                <span>摄像头</span>
                            </button>
                        </div>
                        <div class="media-dock-control-group control-button-wrap" data-device-control="mic">
                            <button id="toggleAudio" aria-haspopup="dialog" aria-expanded="false" aria-controls="mic-device-panel" aria-keyshortcuts="Shift+F10" class="media-dock-action-button" type="button" title="麦克风" aria-label="麦克风" aria-pressed="false">
                                <i class="fas fa-microphone"></i>
                                <span>麦克风</span>
                            </button>
                        </div>
                        <div class="media-dock-control-group control-button-wrap" data-device-control="output">
                            <button id="toggleOutput" aria-haspopup="dialog" aria-expanded="false" aria-controls="output-device-panel" aria-keyshortcuts="Shift+F10" class="media-dock-action-button" type="button" title="听筒" aria-label="听筒" aria-pressed="false">
                                <i class="fas fa-volume-up"></i>
                                <span>播放音量</span>
                            </button>
                        </div>
                    </div>
                    <section class="media-device-popover mic-volume-popover" id="mic-device-panel" data-control-panel="mic" data-device-popover="mic" popover="manual" role="dialog" aria-label="麦克风设备">
                        <div class="media-device-popover-header">
                            <strong>麦克风</strong>
                            <span id="micDeviceStatus">默认设备</span>
                        </div>
                        <div class="media-device-list" data-device-list="mic"></div>
                        <label class="media-volume-row">
                            <span>输入音量</span>
                            <input id="micGainSlider" type="range" min="0" max="200" step="5" value="100">
                            <strong id="micGainValue">100%</strong>
                        </label>
                        <label class="media-select-row"><span>降噪模式</span>
                            <select data-audio-noise-mode aria-label="降噪模式">
                                <option value="off">关闭</option>
                                <option value="browser">浏览器内置</option>
                                <option value="rnnoise">RNNoise</option>
                            </select>
                        </label>
                        <label class="media-device-status">
                            <input type="checkbox" data-rnnoise-speech-gate checked>
                            非语音门控（RNNoise）
                        </label>
                        <p class="media-device-status" data-audio-processing-status role="status" hidden></p>
                    </section>
                    <section class="media-device-popover" id="camera-device-panel" data-control-panel="camera" data-device-popover="camera" popover="manual" role="dialog" aria-label="摄像头设备">
                        <div class="media-device-popover-header">
                            <strong>摄像头</strong>
                            <span id="cameraDeviceStatus">默认设备</span>
                        </div>
                        <div class="media-device-list" data-device-list="camera"></div>
                    </section>
                    <section class="media-device-popover" id="output-device-panel" data-control-panel="output" data-device-popover="output" popover="manual" role="dialog" aria-label="输出设备">
                        <div class="media-device-popover-header">
                            <strong>声音</strong>
                            <span id="outputDeviceStatus">默认设备</span>
                        </div>
                        <p class="media-device-warning hidden" data-output-unsupported>当前浏览器不支持选择输出设备</p>
                        <div class="media-device-list" data-device-list="output"></div>
                        <label class="media-volume-row">
                            <span>输出音量</span>
                            <input id="outputVolume" type="range" min="0" max="2" step="0.05" value="1">
                            <strong id="outputVolumeValue">100%</strong>
                        </label>
                        <label class="voice-event-sound-toggle"><input id="voiceEventSounds" type="checkbox" checked><span>成员加入 / 离开提示音</span></label>
                        <label class="media-volume-row">
                            <span>提示音量</span>
                            <input id="voiceEventVolume" type="range" min="0" max="1" step="0.05" value="0.5">
                            <strong id="voiceEventVolumeValue">50%</strong>
                        </label>
                        <p class="voice-event-sound-hint">加入 do–re，离开 re–do。跟随总静音和当前输出设备。</p>
                        <p id="voiceEventSoundStatus" class="voice-event-sound-hint" role="status"></p>
                    </section>
                    <%- include('share-dialog', { piikPrototype }) %>
                </div>
            </section>
        </footer>
        </div>
        <main class="room-stage" aria-label="屏幕共享舞台">
            <header class="share-stage-header"><nav id="share-sources" aria-label="选择共享源"></nav>
                <div class="local-share-controls" data-local-share-controls hidden><span data-local-share-state role="status">正在共享</span>
                    <button type="button" data-share-action="source"><i class="fas fa-exchange-alt" aria-hidden="true"></i>换画面</button>
                    <button type="button" data-share-action="quality"><i class="fas fa-sliders-h" aria-hidden="true"></i>画质</button>
                    <button type="button" data-share-action="stop"><i class="fas fa-stop" aria-hidden="true"></i>停止共享</button></div>
            </header>
            <section id="canvas" class="stage-canvas" aria-label="共享画面"><div id="video-grid"></div></section>
        </main>
        <section class="stage-members" aria-label="语音成员舞台">
            <p id="stageShareNotice" class="stage-share-notice" role="status" hidden></p>
            <header class="members-heading"><div><strong id="stageChannelName"><%= channelName %></strong><span id="stageChannelStatus">语音成员舞台</span></div><span id="member-count">0 人</span></header>
            <div id="members-empty" class="members-empty" role="status">
                <div class="stage-welcome-mark" aria-hidden="true">◖◗</div>
                <h1 id="stageWelcomeTitle">加入语音，一起待一会儿</h1>
                <p id="stageWelcomeDetail">加入后，成员头像与摄像头会显示在中央；共享屏幕时自动切换到观看舞台。</p>
                <button id="stageJoinVoice" type="button">加入语音</button>
            </div>
            <div id="member-cards" role="list" aria-label="成员卡片"></div>
        </section>

        <aside id="chat-panel" class="chat-panel" aria-label="频道聊天">
            <header class="stage-chat-heading"><h2 id="chatTitle">频道聊天</h2><button id="chatJumpToLatest" type="button" hidden>查看新消息</button></header>
            <input id="chatName" type="hidden" maxlength="32" autocomplete="nickname">
            <ol id="chatMessages" class="chat-messages"></ol>
            <form id="chatForm" class="chat-form">
                <textarea id="chatInput" maxlength="500" rows="2" placeholder="发送消息"></textarea>
                <button type="submit">发送</button>
            </form>
        </aside>

    </div> 
    <% if (piikPrototype) { %><script defer src="/vendor/piik-client.js?v=<%= roomAssetVersions.piikClient %>"></script><% } else { %><script defer src="/vendor/screen-sfu-client.js"></script><% } %>
    <script defer src="/js/room/boot-runtime.js?v=<%= roomAssetVersions.runtime %>"></script>
    <script type="module" src="/script.js?v=<%= roomAssetVersions.mainScript %>"></script>
</body>
</html>
